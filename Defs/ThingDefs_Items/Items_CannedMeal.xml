<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="MealBase">
		<defName>Rosen_CannedMeal</defName>
		<label>canned meal</label>
		<description>A meal cooked and secured in a steel can effectively extending shelf life indefinitely. \nCanned meals require more work to make and are heavier than other canned goods, and cannot be used as an ingredient. Compared to packaged survival meals, they are heavier, require more work to make, and provide slightly less nutrition</description>
		<graphicData>
			<texPath>Things/CannedMeals</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<tradeability>Sellable</tradeability>
		<stackLimit>12</stackLimit>
		<statBases>
			<MarketValue>12</MarketValue>
			<WorkToMake>900</WorkToMake>
			<Nutrition>0.8</Nutrition>
			<Mass>0.6</Mass>
		</statBases>
		<rotatable>false</rotatable>
		<ingestible>
			<canAutoSelectAsFoodForCaravan>true</canAutoSelectAsFoodForCaravan>
			<preferability>MealSimple</preferability>
		    <optimalityOffsetHumanlikes>-5</optimalityOffsetHumanlikes>
            <optimalityOffsetFeedingAnimals>-10</optimalityOffsetFeedingAnimals>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
			<maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
		</ingestible>
		
	</ThingDef>

</Defs>